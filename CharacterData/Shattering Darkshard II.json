        "german": "Zerschmetternder Finstersplitter II",
        "russian": "Треснутый темный осколок II",
        "portuguese": "Fragmento Sombrio Destruidor II",
        "chinese": "破碎黑暗碎片 II",
        "spanish": "Fragmento oscuro detonante II",
        "chinese_traditional": "崩裂黑暗碎片II",
        "korean": "분쇄의 어둠의 파편 II",
